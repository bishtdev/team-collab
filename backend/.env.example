# Copy to .env and fill in.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/team-collab
FRONTEND_URL=http://localhost:5173

# --- Workspaces / access ---
# Comma-separated break-glass owners (bypass checks for support/recovery).
ADMIN_EMAILS=you@company.com,backup@company.com
# true = any signed-up user can POST /api/orgs and become OWNER of a new isolated org.
ALLOW_ORG_CREATION=true
INVITE_TTL_HOURS=48
# Name for the one-time legacy migration org (npm run migrate:orgs)
LEGACY_ORG_NAME=Legacy Workspace

# --- Rate limiting (per IP) ---
RATE_GENERAL_MAX=5000
RATE_AUTH_MAX=1000

# --- Invite email (dev works without it — the link is logged) ---
# RESEND_API_KEY=re_...
# MAIL_FROM=Kiln <onboarding@resend.dev>

# --- Firebase / Cloudinary (existing) ---
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...} (prod) or config/firebaseServiceAccount.json (dev)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
